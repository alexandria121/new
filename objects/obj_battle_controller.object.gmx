      "IsDnD": false,
      "m_lazyFunctionBody": "/// Create: set up AI vs AI mode and start the game\nglobal.ai_vs_ai_mode = true;\nglobal.battle_started = false;\nglobal.ai_vs_ai_started = false;\nglobal.battle_complete = false;\nglobal.winner = \"\";",
      "actionScripts": []
    },
    {
      "eventNum": 0,
      "eventType": 8,
      "m_IsCollisionEvent": false,
      "enumb": 64,
      "collisionObjectId": -1,
      "eventOwner": -1,
      "IsDnD": false,
      "m_lazyFunctionBody": "/// Draw: menu overlay if battle not started, else battle UI\nif (!global.battle_started) {\n    // Draw menu\n    draw_set_color(c_black);\n    draw_rectangle(0, 0, display_get_width(), display_get_height(), false);\n    draw_set_color(c_white);\n    draw_set_halign(fa_center);\n    draw_set_font(fnt_title);\n    draw_text(display_get_width()/2, display_get_height()/2 - 60, \"AI vs AI Battle\");\n    \n    var bx = display_get_width()/2 - 100;\n    var by = display_get_height()/2;\n    draw_set_color(c_dkgray);\n    draw_roundrect(bx, by, bx+200, by+60, 8, false);\n    draw_set_color(c_white);\n    draw_set_font(fnt_normal);\n    draw_text(bx+100, by+30, \"Start Battle\");\n    \n    // Button click detection\n    if (mouse_check_button_pressed(mb_left)) {\n        if (point_in_rectangle(mouse_x, mouse_y, bx, by, bx+200, by+60)) {\n            InitializeGame();\n            global.battle_started = true;\n            global.ai_vs_ai_started = true;\n            global.ai_vs_ai_mode = true;\n            StartTurn();\n        }\n    }\n} else {\n    // Draw battle UI\n    var g = global.game;\n    \n    // Background\n    draw_set_color(make_color_rgb(20, 20, 40));\n    draw_rectangle(0, 0, display_get_width(), display_get_height(), false);\n    \n    // AI health bar (top)\n    draw_set_color(c_gray);\n    draw_rectangle(40, 20, 540, 50, false);\n    var aiHpRatio = g.aiHealth / 30;\n    draw_set_color(c_red);\n    draw_rectangle(40, 20, 40 + 500*aiHpRatio, 50, false);\n    draw_set_color(c_white);\n    draw_text(290, 35, \"AI: \" + string(g.aiHealth) + \"/30 HP\");\n    \n    // Player health bar (bottom)\n    draw_set_color(c_gray);\n    draw_rectangle(40, 640, 540, 670, false);\n    var plHpRatio = g.playerHealth / 30;\n    draw_set_color(c_green);\n    draw_rectangle(40, 640, 40 + 500*plHpRatio, 670, false);\n    draw_set_color(c_white);\n    draw_text(290, 655, \"Player: \" + string(g.playerHealth) + \"/30 HP\");\n    \n    // Mana display\n    draw_set_color(c_blue);\n    draw_text(40, 60, \"Mana: \" + string(g.currentMana) + \"/\" + string(g.maxMana));\n    \n    // AI hand (3 slots at top)\n    draw_set_color(c_white);\n    draw_text(40, 90, \"AI Hand:\");\n    for (var i = 0; i < ds_list_size(g.aiHand); i++) {\n        var card = ds_list_find_value(g.aiHand, i);\n        if (!is_undefined(card) && card != noone) {\n            draw_set_color(c_blue);\n            draw_rectangle(40 + i*110, 110, 140 + i*110, 170, false);\n            draw_set_color(c_white);\n            draw_text(90 + i*110, 140, card.name);\n        }\n    }\n    \n    // AI board (3 slots)\n    draw_set_color(c_white);\n    draw_text(40, 190, \"AI Board:\");\n    for (var i = 0; i < 3; i++) {\n        var slotCard = (i < ds_list_size(g.aiBoard)) ? ds_list_find_value(g.aiBoard, i) : noone;\n        draw_set_color(c_navy);\n        draw_rectangle(40 + i*110, 210, 140 + i*110, 280, false);\n        if (!is_undefined(slotCard) && slotCard != noone) {\n            draw_set_color(c_white);\n            draw_text(90 + i*110, 235, slotCard.name);\n            draw_text(90 + i*110, 260, \"ATK:\" + string(slotCard.attack) + \" HP:\" + string(slotCard.health));\n        }\n    }\n    \n    // Divider line\n    draw_set_color(c_orange);\n    draw_line(0, 420, display_get_width(), 420);\n    \n    // Player board (3 slots)\n    draw_set_color(c_white);\n    draw_text(40, 440, \"Player Board:\");\n    for (var i = 0; i < 3; i++) {\n        var slotCard = (i < ds_list_size(g.playerBoard)) ? ds_list_find_value(g.playerBoard, i) : noone;\n        draw_set_color(c_dkgreen);\n        draw_rectangle(40 + i*110, 460, 140 + i*110, 530, false);\n        if (!is_undefined(slotCard) && slotCard != noone) {\n            draw_set_color(c_white);\n            draw_text(90 + i*110, 485, slotCard.name);\n            draw_text(90 + i*110, 510, \"ATK:\" + string(slotCard.attack) + \" HP:\" + string(slotCard.health));\n        }\n    }\n    \n    // Player hand (bottom)\n    draw_set_color(c_white);\n    draw_text(40, 550, \"Player Hand:\");\n    for (var i = 0; i < ds_list_size(g.playerHand); i++) {\n        var card = ds_list_find_value(g.playerHand, i);\n        if (!is_undefined(card) && card != noone) {\n            draw_set_color(c_green);\n            draw_rectangle(40 + i*110, 570, 140 + i*110, 630, false);\n            draw_set_color(c_white);\n            draw_text(90 + i*110, 590, card.name);\n            draw_text(90 + i*110, 610, string(card.manaCost) + \" mana\");\n        }\n    }\n    \n    // Turn / phase info\n    draw_set_color(c_yellow);\n    draw_text(display_get_width() - 200, 60, \"Turn \" + string(g.turnCount));\n    draw_text(display_get_width() - 200, 85, (g.currentPlayer == 0 ? \"Player\" : \"AI\") + \" turn\");\n    draw_text(display_get_width() - 200, 110, \"Phase: \" + string(g.currentPhase));\n    \n    // Game log display\n    draw_set_color(c_black);\n    draw_rectangle(display_get_width() - 310, 140, display_get_width() - 10, 670, false);\n    draw_set_color(c_lime);\n    var logStr = GetGameLogText();\n    var logLines = string_height_ext(logStr, 14, 290);\n    draw_text_ext(display_get_width() - 300, 150, logStr, 14, 290);\n    \n    // Winner announcement\n    if (global.battle_complete) {\n        draw_set_color(c_black);\n        draw_rectangle(0, 0, display_get_width(), display_get_height(), false);\n        draw_set_color(c_gold);\n        draw_set_font(fnt_title);\n        draw_set_halign(fa_center);\n        if (global.winner == \"Player\") {\n            draw_text(display_get_width()/2, display_get_height()/2 - 30, \"VICTORY!\");\n        } else if (global.winner == \"AI\") {\n            draw_text(display_get_width()/2, display_get_height()/2 - 30, \"DEFEAT!\");\n        } else {\n            draw_text(display_get_width()/2, display_get_height()/2 - 30, \"GAME OVER\");\n        }\n        draw_set_color(c_white);\n        draw_set_font(fnt_normal);\n        draw_text(display_get_width()/2, display_get_height()/2 + 20, \"Press R to restart\");\n    }\n}",
      "actionScripts": []
    }
  ],
