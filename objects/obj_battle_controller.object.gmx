{
  "name": "obj_battle_controller",
  "creationCode": "",
  "creationTimestamp": 1737000003,
  "events": [
    {
      "eventNum": 0,
      "eventType": 3,
      "m_IsCollisionEvent": false,
      "enumb": 64,
      "collisionObjectId": -1,
      "eventOwner": -1,
      "IsDnD": false,
      "m_lazyFunctionBody": "/// Step: arm alarm[0] for AI vs AI turn ticks\nif (global.battle_started && global.ai_vs_ai_mode && !global.battle_complete) {\n    if (alarm[0] < 0) alarm[0] = room_speed * 2;\n}",
      "actionScripts": []
    },
    {
      "eventNum": 0,
      "eventType": 2,
      "m_IsCollisionEvent": false,
      "enumb": 0,
      "collisionObjectId": -1,
      "eventOwner": -1,
      "IsDnD": false,
      "m_lazyFunctionBody": "/// Alarm[0]: AI executes a decision loop (DecideAction -> execute -> repeat)\n/// Guards prevent re-entrancy via alarm[0] reset in Step\nif (global.battle_started && global.ai_vs_ai_mode && !global.battle_complete) {\n    alarm[0] = -1;\n    if (!variable_global_exists(\"ai_opponent\")) {\n        global.ai_opponent = new OpponentAI(global.ai_difficulty.Journeyman);\n    }\n    var done = false;\n    for (var iter = 0; !done && iter < 20; iter++) {\n        // Build slot arrays (0 = empty, { creature: Card } = occupied)\n        var pSlots = [];\n        var aSlots = [];\n        for (var i = 0; i < ds_list_size(global.game.playerBoard); i++)\n            array_push(pSlots, { creature: ds_list_find_value(global.game.playerBoard, i),\n                is_empty: function() { return is_undefined(creature) || creature == noone; } });\n        for (var i = 0; i < ds_list_size(global.game.aiBoard); i++)\n            array_push(aSlots, { creature: ds_list_find_value(global.game.aiBoard, i),\n                is_empty: function() { return is_undefined(creature) || creature == noone; } });\n        var dWrap = { hand: global.game.aiHand, creatureSlots: aSlots, DeckDrawCard: function() { return noone; } };\n        var decision = global.ai_opponent.decide_action(dWrap, global.game.currentMana, pSlots, aSlots);\n        switch (decision.decisionType) {\n            case global.ai_decision_type.PlayCreature:\n                if (decision.slotIndex != undefined)\n                    PlayCreature(decision.cardId, decision.slotIndex);\n                break;\n            case global.ai_decision_type.PlaySpell:\n                if (decision.cardId != undefined)\n                    PlaySpell(decision.cardId, (decision.targetCard != undefined) ? 0 : 1);\n                break;\n            case global.ai_decision_type.EndTurn:\n            case global.ai_decision_type.Pass:\n            default:\n                done = true;\n                EndTurn();\n                break;\n        }\n        if (global.battle_complete) done = true;\n    }\n}",
      "actionScripts": []
    },
    {
      "eventNum": 0,
      "eventType": 7,
      "m_IsCollisionEvent": false,
      "enumb": 27,
      "collisionObjectId": -1,
      "eventOwner": -1,
      "IsDnD": false,
      "m_lazyFunctionBody": "/// KeyPress Escape: return to menu\nif (global.battle_started && keyboard_check_pressed(vk_escape)) {\n    if (room_exists(room_menu)) room_goto(room_menu);\n}",
      "actionScripts": []
    },
    {
      "eventNum": 0,
      "eventType": 0,
      "m_IsCollisionEvent": false,
      "enumb": 0,
      "collisionObjectId": -1,
      "eventOwner": -1,
      "IsDnD": false,
      "m_lazyFunctionBody": "/// Create: set up AI vs AI mode and start the game\nglobal.ai_vs_ai_mode = true;\nglobal.battle_started = false;\nglobal.ai_vs_ai_started = false;\nglobal.battle_complete = false;\nglobal.winner = \"\";",
      "actionScripts": []
    },
    {
      "eventNum": 0,
      "eventType": 8,
      "m_IsCollisionEvent": false,
      "enumb": 64,
      "collisionObjectId": -1,
      "eventOwner": -1,
      "IsDnD": false,
      "m_lazyFunctionBody": "/// Draw: menu overlay if battle not started, else battle UI\nif (!global.battle_started) {\n    draw_set_color(c_black);\n    draw_rectangle(0, 0, display_get_width(), display_get_height(), false);\n    draw_set_color(c_white);\n    draw_set_halign(fa_center);\n    draw_set_font(fnt_title);\n    draw_text(display_get_width()/2, display_get_height()/2 - 60, \"AI vs AI Battle\");\n    var bx = display_get_width()/2 - 100;\n    var by = display_get_height()/2;\n    draw_set_color(c_dkgray);\n    draw_roundrect(bx, by, bx+200, by+60, 8, false);\n    draw_set_color(c_white);\n    draw_set_font(fnt_normal);\n    draw_text(bx+100, by+30, \"Start Battle\");\n    if (mouse_check_button_pressed(mb_left)) {\n        if (point_in_rectangle(mouse_x, mouse_y, bx, by, bx+200, by+60)) {\n            InitializeGame();\n            global.battle_started = true;\n            global.ai_vs_ai_started = true;\n            global.ai_vs_ai_mode = true;\n            StartTurn();\n        }\n    }\n} else {\n    // Render battle UI via BattleUI_Draw()\n    BattleUI_Draw(global.game);\n    // Winner/Defeat overlay drawn on top by BattleUI_Draw caller\n    if (global.battle_complete) {\n        draw_set_color(make_color_rgb(0, 0, 0));\n        draw_rectangle(0, 0, display_get_width(), display_get_height(), false);\n        draw_set_halign(fa_center);\n        draw_set_valign(fa_middle);\n        draw_set_font(fnt_title);\n        if (global.winner == \"Player\") {\n            draw_set_color(c_green);\n            draw_text(display_get_width()/2, display_get_height()/2 - 20, \"VICTORY!\");\n        } else if (global.winner == \"AI\") {\n            draw_set_color(c_red);\n            draw_text(display_get_width()/2, display_get_height()/2 - 20, \"DEFEAT!\");\n        } else {\n            draw_set_color(c_white);\n            draw_text(display_get_width()/2, display_get_height()/2 - 20, \"GAME OVER\");\n        }\n        draw_set_color(c_white);\n        draw_set_font(fnt_normal);\n        draw_text(display_get_width()/2, display_get_height()/2 + 30, \"Press R to restart\");\n        draw_set_valign(fa_top);\n        draw_set_halign(fa_left);\n    }\n}",
      "actionScripts": []
    }
  ],
