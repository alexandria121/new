      "IsDnD": false,
      "m_lazyFunctionBody": "/// Create: initialize gallery state\nif (!variable_global_exists('gallery_filter')) {\n    global.gallery_filter = 'All';\n}",
      "actionScripts": []
    },
    {
      "eventNum": 0,
      "eventType": 8,
      "m_IsCollisionEvent": false,
      "enumb": 64,
      "collisionObjectId": -1,
      "eventOwner": -1,
      "IsDnD": false,
      "m_lazyFunctionBody": "/// Draw: render the full gallery UI\nvar mx = mouse_x;\nvar my = mouse_y;\n\n// Background\ndraw_set_color(make_color_rgb(15, 10, 25));\ndraw_rectangle(0, 0, room_width, room_height, false);\n\n// Title\ndraw_set_color(c_white);\ndraw_set_halign(fa_center);\ndraw_text(room_width / 2, 20, 'Card Gallery - ' + global.gallery_filter);\n\n// ── Element filter buttons ───────────────────────────────────────────────────────\nvar filterY = 55;\nvar filterSpacing = 90;\nvar filterStartX = room_width / 2 - 2 * filterSpacing;\nvar elements = ['All', 'Fire', 'Water', 'Earth', 'Air'];\n\nfor (var i = 0; i < 5; i++) {\n    var fx = filterStartX + i * filterSpacing;\n    var isHover = (mx >= fx - 40 && mx <= fx + 40 && my >= filterY - 15 && my <= filterY + 15);\n    var isSel = (global.gallery_filter == elements[i]);\n    DrawGalleryFilterButton(fx, filterY, elements[i], isSel, isHover);\n}\n\n// ── Card grid (5 cols x 4 rows) ───────────────────────────────────────────────\nvar CARD_W = 118;\nvar CARD_H = 158;\nvar COLS = 5;\nvar ROWS = 4;\nvar gridW = COLS * CARD_W;\nvar gridH = ROWS * CARD_H;\nvar gridX = (room_width - gridW) / 2;\nvar gridY = 90;\n\n// Count cards available\nvar totalCards = 0;\nif (global.cards_loaded && ds_exists(global.base_cards, ds_type_map)) {\n    totalCards = ds_map_size(global.base_cards);\n}\n\nfor (var row = 0; row < ROWS; row++) {\n    for (var col = 0; col < COLS; col++) {\n        var idx = row * COLS + col;\n        if (idx >= totalCards) continue;\n\n        var cardX = gridX + col * CARD_W;\n        var cardY = gridY + row * CARD_H;\n\n        // Hover detection\n        var isHover = (mx >= cardX && mx <= cardX + CARD_W && my >= cardY && my <= cardY + CARD_H);\n\n        // Find card by index in base_cards map\n        var cardKey = ds_map_find_first(global.base_cards);\n        var c = undefined;\n        var tmpIdx = 0;\n        if (!is_undefined(cardKey)) {\n            repeat (idx) {\n                cardKey = ds_map_find_next(global.base_cards, cardKey);\n            }\n            c = ds_map_find_value(global.base_cards, cardKey);\n        }\n\n        if (c != undefined && !is_undefined(c)) {\n            // Build a lightweight card wrapper for DrawGalleryCard\n            var wrapper = {\n                name:     ds_map_exists(c, 'name')     ? c[? 'name']     : 'Unknown',\n                element:  ds_map_exists(c, 'element')  ? c[? 'element']  : 'Neutral',\n                manaCost: ds_map_exists(c, 'manaCost') ? c[? 'manaCost'] : 0,\n                power:   ds_map_exists(c, 'power')   ? c[? 'power']   : 0,\n                health:  ds_map_exists(c, 'health')  ? c[? 'health']  : 0\n            };\n\n            // Filter check\n            if (global.gallery_filter != 'All' && wrapper.element != global.gallery_filter) continue;\n\n            DrawGalleryCard(wrapper, cardX, cardY, isHover);\n        } else {\n            // Empty slot\n            draw_set_color(make_color_rgb(30, 30, 45));\n            draw_rectangle(cardX, cardY, cardX + CARD_W, cardY + CARD_H, false);\n            draw_set_color(make_color_rgb(60, 60, 80));\n            draw_rectangle(cardX, cardY, cardX + CARD_W, cardY + CARD_H, true);\n        }\n    }\n}\n\n// ── Back button ───────────────────────────────────────────────────────────────\nvar btnW = 200;\nvar btnH = 50;\nvar btnX = (room_width - btnW) / 2;\nvar btnY = gridY + gridH + 20;\nDrawGalleryBackButton(btnX, btnY, btnW, btnH, mx, my);\n\ndraw_set_halign(fa_left);",
      "actionScripts": []
    },
    {
      "eventNum": 1,
      "eventType": 6,
      "m_IsCollisionEvent": false,
      "enumb": 0,
      "collisionObjectId": -1,
      "eventOwner": -1,
      "IsDnD": false,
      "m_lazyFunctionBody": "/// Left Pressed: handle filter and back button clicks\nif (!mouse_check_button_pressed(mb_left)) exit;\n\nvar mx = mouse_x;\nvar my = mouse_y;\n\n// Filter buttons\nvar filterY = 55;\nvar filterSpacing = 90;\nvar filterStartX = room_width / 2 - 2 * filterSpacing;\nvar elements = ['All', 'Fire', 'Water', 'Earth', 'Air'];\n\nfor (var i = 0; i < 5; i++) {\n    var fx = filterStartX + i * filterSpacing;\n    if (mx >= fx - 40 && mx <= fx + 40 && my >= filterY - 15 && my <= filterY + 15) {\n        global.gallery_filter = elements[i];\n        exit;\n    }\n}\n\n// Back button\nvar CARD_W = 118;\nvar CARD_H = 158;\nvar COLS = 5;\nvar ROWS = 4;\nvar gridW = COLS * CARD_W;\nvar gridH = ROWS * CARD_H;\nvar gridX = (room_width - gridW) / 2;\nvar gridY = 90;\nvar btnW = 200;\nvar btnH = 50;\nvar btnX = (room_width - btnW) / 2;\nvar btnY = gridY + gridH + 20;\n\nif (mx >= btnX && mx <= btnX + btnW && my >= btnY && my <= btnY + btnH) {\n    room_goto(room_menu);\n}",
      "actionScripts": []
    }
  ],
