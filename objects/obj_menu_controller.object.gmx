      "m_lazyFunctionBody": "/// Mouse press: start battle\nif (mouse_check_button_pressed(mb_left)) {\n    var bx = display_get_width()/2 - 100;\n    var by = 320;\n    if (point_in_rectangle(mouse_x, mouse_y, bx, by, bx+200, by+60)) {\n        room_goto(room_battle);\n    }\n}",
