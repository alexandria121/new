      "m_lazyFunctionBody": "/// Draw menu label\ndraw_set_color(c_white);\ndraw_set_font(fnt_title);\ndraw_set_halign(fa_center);\ndraw_text(display_get_width()/2, 150, "Magical Deckbuilder");\n\ndraw_set_font(fnt_normal);\ndraw_text(display_get_width()/2, 220, "AI vs AI Battle Simulator");\n\n// Draw Start Battle button\nvar bx = display_get_width()/2 - 100;\nvar by = 320;\ndraw_set_color(c_dkgray);\ndraw_roundrect(bx, by, bx+200, by+60, 8, false);\ndraw_set_color(c_white);\ndraw_text(bx+100, by+30, "Start Battle");",
