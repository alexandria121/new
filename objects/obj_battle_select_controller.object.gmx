      "IsDnD": false,
      "m_lazyFunctionBody": "/// Create: init battle select state\nglobal.selected_difficulty = 0;  // 0=Apprentice, 1=Journeyman, 2=Expert, 3=Grandmaster\nglobal.battle_mode = 'pvp';",
      "actionScripts": []
    },
    {
      "eventNum": 0,
      "eventType": 8,
      "m_IsCollisionEvent": false,
      "enumb": 64,
      "collisionObjectId": -1,
      "eventOwner": -1,
      "IsDnD": false,
      "m_lazyFunctionBody": "/// Draw: render the battle-select UI\nDrawBattleSelectPanel(global.selected_difficulty, global.battle_mode, 0);",
      "actionScripts": []
    },
    {
      "eventNum": 0,
      "eventType": 6,
      "m_IsCollisionEvent": false,
      "enumb": 64,
      "collisionObjectId": -1,
      "eventOwner": -1,
      "IsDnD": false,
      "m_lazyFunctionBody": "/// Mouse Move: update hover cursor region\nvar hover = GetBattleSelectHover(mouse_x, mouse_y);\n// redraw handled automatically by continuous Draw event",
      "actionScripts": []
    },
    {
      "eventNum": 0,
      "eventType": 7,
      "m_IsCollisionEvent": false,
      "enumb": 64,
      "collisionObjectId": -1,
      "eventOwner": -1,
      "IsDnD": false,
      "m_lazyFunctionBody": "/// Left Press: handle button clicks\nif (mouse_check_button_pressed(mb_left)) {\n    var hover = GetBattleSelectHover(mouse_x, mouse_y);\n    \n    if (hover >= 10 && hover <= 13) {\n        // Difficulty button clicked (ids 10-13)\n        global.selected_difficulty = hover - 10;\n    } else if (hover == 3) {\n        // Toggle AI vs AI mode\n        if (global.battle_mode == 'pvp') {\n            global.battle_mode = 'ai_ai';\n        } else {\n            global.battle_mode = 'pvp';\n        }\n    } else if (hover == 1) {\n        // Start Battle\n        global.ai_difficulty = global.selected_difficulty;\n        global.ai_vs_ai_mode = (global.battle_mode == 'ai_ai');\n        if (room_exists(room_battle)) {\n            room_goto(room_battle);\n        } else {\n            show_message(\"room_battle not found — check project resources\");\n        }\n    } else if (hover == 2) {\n        // Back to Menu\n        if (room_exists(room_menu)) {\n            room_goto(room_menu);\n        }\n    }\n}",
      "actionScripts": []
    }
  ],
