{
  "name": "obj_deck_builder_controller",
  "creationCode": "",
  "creationTimestamp": 1737100000,
  "events": [
    {
      "eventNum": 0,
      "eventType": 0,
      "m_IsCollisionEvent": false,
      "enumb": 0,
      "collisionObjectId": -1,
      "eventOwner": -1,
      "IsDnD": false,
      "m_lazyFunctionBody": "/// Create: init deck builder state\n\n// Ensure base cards are loaded\nif (!global.cards_loaded) {\n    load_all_card_data();\n}\n\n// Ensure global.player_deck exists\nif (!ds_exists(global.player_deck, ds_type_list)) {\n    global.player_deck = ds_list_create();\n}\n\n// Initialize default 22-card deck if empty\nif (ds_list_empty(global.player_deck)) {\n    InitDefaultDeck();\n}\n\n// UI state\nglobal.deck_builder_hover = -1;  // -1=none, 0=left-panel card index, 1=right-panel card index, 2+=button ids\n\n// Scroll offset for left card list\nglobal.deck_list_scroll = 0;\n\n// Filter state\nglobal.deck_filter_element = -1;  // -1 = all elements\n\n// Track mouse for hover detection\nmouse_x_prev = mouse_x;\nmouse_y_prev = mouse_y;",
      "actionScripts": []
    },
    {
      "eventNum": 64,
      "eventType": 3,
      "m_IsCollisionEvent": false,
      "enumb": 64,
      "collisionObjectId": -1,
      "eventOwner": -1,
      "IsDnD": false,
      "m_lazyFunctionBody": "/// Clean Up: destroy ds_list when room exits\nif (ds_exists(global.player_deck, ds_type_list)) {\n    // Don't destroy — global.player_deck persists across rooms\n}",
      "actionScripts": []
    },
    {
      "eventNum": 0,
      "eventType": 8,
      "m_IsCollisionEvent": false,
      "enumb": 64,
      "collisionObjectId": -1,
      "eventOwner": -1,
      "IsDnD": false,
      "m_lazyFunctionBody": "/// Draw: render deck builder UI\nDrawDeckBuilderPanel();",
      "actionScripts": []
    },
    {
      "eventNum": 0,
      "eventType": 6,
      "m_IsCollisionEvent": false,
      "enumb": 64,
      "collisionObjectId": -1,
      "eventOwner": -1,
      "IsDnD": false,
      "m_lazyFunctionBody": "/// Mouse Move: update hover regions\nvar hover = GetDeckBuilderHover(mouse_x, mouse_y);\n// Redraw handled by continuous Draw event",
      "actionScripts": []
    },
    {
      "eventNum": 0,
      "eventType": 7,
      "m_IsCollisionEvent": false,
      "enumb": 64,
      "collisionObjectId": -1,
      "eventOwner": -1,
      "IsDnD": false,
      "m_lazyFunctionBody": "/// Left Pressed: handle button clicks\nvar action = GetDeckBuilderHover(mouse_x, mouse_y);\n\nif (action >= 0) {\n    switch (action) {\n        // ── Scroll buttons ──────────────────────────────────\n        case 100:  // Scroll up\n            global.deck_list_scroll = max(0, global.deck_list_scroll - 1);\n            break;\n        case 101:  // Scroll down\n            global.deck_list_scroll = min(global.deck_list_scroll + 1, 9999);\n            break;\n            \n        // ── Element filter buttons ──────────────────────────\n        case 200: global.deck_filter_element = -1; break;  // All\n        case 201: global.deck_filter_element = 0; break;  // Radioactivity\n        case 202: global.deck_filter_element = 1; break;  // Flesh\n        case 203: global.deck_filter_element = 2; break;  // Toxin\n        case 204: global.deck_filter_element = 3; break;  // Fungus\n        case 205: global.deck_filter_element = 4; break;  // Thermodynamics\n        case 206: global.deck_filter_element = 5; break;  // Time\n        case 207: global.deck_filter_element = 6; break;  // Food\n        case 208: global.deck_filter_element = 7; break;  // Eldritch\n        \n        // ── Save / Load / Back ─────────────────────────────\n        case 300:  // Save Deck\n            if (SaveDeckToFile(global.player_deck)) {\n                show_debug_message(\"[DeckBuilder] Deck saved successfully\");\n            } else {\n                show_debug_message(\"[DeckBuilder] Failed to save deck\");\n            }\n            break;\n        case 301:  // Load Deck\n            if (LoadDeckFromFile()) {\n                show_debug_message(\"[DeckBuilder] Deck loaded successfully\");\n            } else {\n                show_debug_message(\"[DeckBuilder] Failed to load deck — using default\");\n            }\n            break;\n        case 302:  // Back to Menu\n            room_goto(room_menu);\n            break;\n            \n        default:\n            break;\n    }\n}",
      "actionScripts": []
    },
    {
      "eventNum": 0,
      "eventType": 5,
      "m_IsCollisionEvent": false,
      "enumb": 64,
      "collisionObjectId": -1,
      "eventOwner": -1,
      "IsDnD": false,
      "m_lazyFunctionBody": "/// Mouse Wheel Down: scroll card list down\nif (mouse_wheel_down()) {\n    global.deck_list_scroll = min(global.deck_list_scroll + 3, 9999);\n}\n\n/// Mouse Wheel Up: scroll card list up\nif (mouse_wheel_up()) {\n    global.deck_list_scroll = max(0, global.deck_list_scroll - 3);\n}",
      "actionScripts": []
    },
    {
      "eventNum": 0,
      "eventType": 11,
      "m_IsCollisionEvent": false,
      "enumb": 64,
      "collisionObjectId": -1,
      "eventOwner": -1,
      "IsDnD": false,
      "m_lazyFunctionBody": "/// Keyboard: keyboard shortcut handling\nif (keyboard_check_pressed(vk_escape)) {\n    room_goto(room_menu);\n}\n\nif (keyboard_check_pressed(ord(\"S\")) && keyboard_check(vk_control) {\n    SaveDeckToFile(global.player_deck);\n}\n\nif (keyboard_check_pressed(ord(\"L\")) && keyboard_check(vk_control) {\n    LoadDeckFromFile();\n}",
      "actionScripts": []
    }
  ],
