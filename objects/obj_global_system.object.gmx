      "collisionObjectId": -1,
      "eventOwner": -1,
      "IsDnD": false,
      "m_lazyFunctionBody": "/// Create: load all data and initialize decks\nif (!global.cards_loaded) {\n    load_all_card_data();\n}\n\nif (!variable_global_exists(\"playerDeck\") || global.playerDeck == noone) {\n    global.playerDeck = CreateDeck(true);\n}\nif (!variable_global_exists(\"aiDeck\") || global.aiDeck == noone) {\n    global.aiDeck = CreateDeck(false);\n}\n\nshow_debug_message(\"obj_global_system: cards loaded=\" + string(global.cards_loaded)\n                + \", playerDeck=\" + string(ds_exists(global.playerDeck, ds_type_list))\n                + \", aiDeck=\" + string(ds_exists(global.aiDeck, ds_type_list)));",
      "actionScripts": []
    },
    {
      "eventNum": 0,
      "eventType": 1,
      "m_IsCollisionEvent": false,
      "enumb": 0,
      "collisionObjectId": -1,
      "eventOwner": -1,
      "IsDnD": false,
      "m_lazyFunctionBody": "/// Destroy: clean up ds lists if they exist\nif (ds_exists(global.playerDeck, ds_type_list)) { ds_list_destroy(global.playerDeck); }\nif (ds_exists(global.aiDeck,     ds_type_list)) { ds_list_destroy(global.aiDeck);     }\nif (ds_exists(global.base_cards,      ds_type_map)) { ds_map_destroy(global.base_cards);      }\nif (ds_exists(global.combo_registry,   ds_type_map)) { ds_map_destroy(global.combo_registry);   }\nglobal.cards_loaded = false;",
      "actionScripts": []
    },
    {
      "eventNum": 0,
      "eventType": 2,
      "m_IsCollisionEvent": false,
      "enumb": 70,
      "collisionObjectId": -1,
      "eventOwner": -1,
      "IsDnD": false,
      "m_lazyFunctionBody": "/// Async Event — keyboard press\nif (keyboard_check_pressed(ord(\"R\"))) {\n    // Reset and restart\n    if (global.battle_complete) {\n        global.battle_started = false;\n        global.battle_complete = false;\n        global.winner = \"\";\n        room_restart();\n    }\n}",
      "actionScripts": []
    },
    {
      "eventNum": 0,
      "eventType": 8,
      "m_IsCollisionEvent": false,
      "enumb": 3,
      "collisionObjectId": -1,
      "eventOwner": -1,
      "IsDnD": false,
      "m_lazyFunctionBody": "/// Step: AI vs AI battle loop (every 60 frames ~ 1 second)\n// Uses scr_opponent_ai.gml functions if available;\n// otherwise falls back to simple random play.\nif (global.ai_vs_ai_mode && global.ai_vs_ai_started && global.battle_started && !global.battle_complete) {\n    // Execute AI decision every 60 frames\n    if (room_speed == 30) {\n        if (0 == (floor(get_timer() / 1000000) mod 2)) {\n            return; // throttle to ~every 2 seconds in practice via alarm\n        }\n    }\n    \n    if (function_exists(\"AI_MakeMove\")) {\n        AI_MakeMove();\n    } else {\n        // Simple fallback: play random card from hand if possible\n        var g = global.game;\n        if (g.currentPlayer == 1) { // AI's turn\n            var hand = g.aiHand;\n            if (ds_list_size(hand) > 0) {\n                var rng_card = ds_list_find_value(hand, floor(random(ds_list_size(hand))));\n                if (!is_undefined(rng_card) && rng_card != noone) {\n                    // Find an empty board slot\n                    var board = g.aiBoard;\n                    var slot = -1;\n                    for (var i = 0; i < ds_list_size(board); i++) {\n                        if (ds_list_find_value(board, i) == noone) { slot = i; break; }\n                    }\n                    if (slot >= 0) {\n                        PlayCreature(rng_card.cardId, slot);\n                    }\n                }\n            }\n        }\n    }\n    \n    // Check win after AI move\n    if (CheckWinCondition()) {\n        global.battle_complete = true;\n        if (global.game.aiHealth <= 0) { global.winner = \"Player\"; }\n        else if (global.game.playerHealth <= 0) { global.winner = \"AI\"; }\n        else { global.winner = \"Draw\"; }\n        return;\n    }\n    \n    // End turn for current player if AI\n    if (g.currentPlayer == 1) {\n        EndTurn();\n    }\n}",
      "actionScripts": []
    }
  ],
