<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Dark Theme Colors -->
    <Color x:Key="BackgroundColor">#1E1E28</Color>
    <Color x:Key="SurfaceColor">#282830</Color>
    <Color x:Key="SurfaceLightColor">#32323C</Color>
    <Color x:Key="PrimaryColor">#4A9EFF</Color>
    <Color x:Key="SecondaryColor">#2D2D3A</Color>
    <Color x:Key="AccentColor">#FF6B35</Color>
    <Color x:Key="TextPrimaryColor">#FFFFFF</Color>
    <Color x:Key="TextSecondaryColor">#B0B0B0</Color>
    <Color x:Key="TextTertiaryColor">#707070</Color>
    <Color x:Key="SuccessColor">#4CAF50</Color>
    <Color x:Key="WarningColor">#FF9800</Color>
    <Color x:Key="DangerColor">#F44336</Color>
    <Color x:Key="ManaColor">#00BCD4</Color>
    <Color x:Key="HealthColor">#4CAF50</Color>

    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="SurfaceLightBrush" Color="{StaticResource SurfaceLightColor}"/>
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource SecondaryColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource TextTertiaryColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
    <SolidColorBrush x:Key="ManaBrush" Color="{StaticResource ManaColor}"/>
    <SolidColorBrush x:Key="HealthBrush" Color="{StaticResource HealthColor}"/>

    <!-- Card Type Colors -->
    <SolidColorBrush x:Key="SpellBrush" Color="#FF6464"/>
    <SolidColorBrush x:Key="CreatureBrush" Color="#64FF64"/>
    <SolidColorBrush x:Key="ArtifactBrush" Color="#C8C864"/>
    <SolidColorBrush x:Key="EnchantmentBrush" Color="#9664C8"/>
    <SolidColorBrush x:Key="WeaponBrush" Color="#FF9632"/>
    <SolidColorBrush x:Key="ArmorBrush" Color="#6496C8"/>
    <SolidColorBrush x:Key="EventBrush" Color="#FFC864"/>
    <SolidColorBrush x:Key="BlankBrush" Color="#C8C8C8"/>

    <!-- Game Element Colors (Full Colors) -->
    <SolidColorBrush x:Key="RadioactivityBrush" Color="#00FF64"/>
    <SolidColorBrush x:Key="FleshBrush" Color="#C86464"/>
    <SolidColorBrush x:Key="ToxinBrush" Color="#96C800"/>
    <SolidColorBrush x:Key="FungusBrush" Color="#649664"/>
    <SolidColorBrush x:Key="ThermodynamicsBrush" Color="#FF6432"/>
    <SolidColorBrush x:Key="TimeBrush" Color="#9664C8"/>
    <SolidColorBrush x:Key="FoodBrush" Color="#C89664"/>
    <SolidColorBrush x:Key="EldritchBrush" Color="#6400C8"/>

    <!-- Element Gradient Brushes for Card Borders -->
    <LinearGradientBrush x:Key="RadioactivityGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#00FF64" Offset="0"/>
        <GradientStop Color="#00CC50" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="FleshGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#C86464" Offset="0"/>
        <GradientStop Color="#A05050" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ToxinGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#96C800" Offset="0"/>
        <GradientStop Color="#78A000" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="FungusGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#649664" Offset="0"/>
        <GradientStop Color="#507850" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ThermodynamicsGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF6432" Offset="0"/>
        <GradientStop Color="#CC5028" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="TimeGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#9664C8" Offset="0"/>
        <GradientStop Color="#7850A0" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="FoodGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#C89664" Offset="0"/>
        <GradientStop Color="#A07850" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="EldritchGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#6400C8" Offset="0"/>
        <GradientStop Color="#5000A0" Offset="1"/>
    </LinearGradientBrush>

    <!-- Rarity Colors -->
    <SolidColorBrush x:Key="CommonBrush" Color="#B4B4B4"/>
    <SolidColorBrush x:Key="UncommonBrush" Color="#64C864"/>
    <SolidColorBrush x:Key="RareBrush" Color="#3264C8"/>
    <SolidColorBrush x:Key="LegendaryBrush" Color="#C89632"/>

    <!-- Rarity Gradient Brushes -->
    <LinearGradientBrush x:Key="LegendaryGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFD700" Offset="0"/>
        <GradientStop Color="#C89632" Offset="0.5"/>
        <GradientStop Color="#FFD700" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="RareGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#5080FF" Offset="0"/>
        <GradientStop Color="#3264C8" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="UncommonGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#80E080" Offset="0"/>
        <GradientStop Color="#64C864" Offset="1"/>
    </LinearGradientBrush>

    <!-- Drop Shadow Effects for Each Element -->
    <DropShadowEffect x:Key="RadioactivityGlow" Color="#00FF64" BlurRadius="15" ShadowDepth="0" Opacity="0.7"/>
    <DropShadowEffect x:Key="FleshGlow" Color="#C86464" BlurRadius="15" ShadowDepth="0" Opacity="0.7"/>
    <DropShadowEffect x:Key="ToxinGlow" Color="#96C800" BlurRadius="15" ShadowDepth="0" Opacity="0.7"/>
    <DropShadowEffect x:Key="FungusGlow" Color="#649664" BlurRadius="15" ShadowDepth="0" Opacity="0.7"/>
    <DropShadowEffect x:Key="ThermodynamicsGlow" Color="#FF6432" BlurRadius="15" ShadowDepth="0" Opacity="0.7"/>
    <DropShadowEffect x:Key="TimeGlow" Color="#9664C8" BlurRadius="15" ShadowDepth="0" Opacity="0.7"/>
    <DropShadowEffect x:Key="FoodGlow" Color="#C89664" BlurRadius="15" ShadowDepth="0" Opacity="0.7"/>
    <DropShadowEffect x:Key="EldritchGlow" Color="#6400C8" BlurRadius="15" ShadowDepth="0" Opacity="0.7"/>
    <DropShadowEffect x:Key="LegendaryGlow" Color="#FFD700" BlurRadius="20" ShadowDepth="0" Opacity="0.9"/>

    <!-- Base Button Style -->
    <Style x:Key="BaseButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource SecondaryBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Primary Button Style -->
    <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
        <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <!-- Accent Button Style -->
    <Style x:Key="AccentButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
        <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <!-- Danger Button Style -->
    <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
        <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
    </Style>

    <!-- Warning Button Style (for Settings) - Yellow/Orange -->
    <Style x:Key="WarningButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
        <Setter Property="Background" Value="#FFC107"/>
        <Setter Property="Foreground" Value="#1A1A1A"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <!-- Card Container Style -->
    <Style x:Key="CardContainerStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource SurfaceLightBrush}"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="8"/>
        <Setter Property="Margin" Value="4"/>
        <Setter Property="Width" Value="140"/>
        <Setter Property="Height" Value="200"/>
    </Style>

    <!-- Title Text Style -->
    <Style x:Key="TitleStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontSize" Value="28"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontFamily" Value="Arial"/>
    </Style>

    <!-- Subtitle Text Style -->
    <Style x:Key="SubtitleStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontFamily" Value="Arial"/>
    </Style>

    <!-- Body Text Style -->
    <Style x:Key="BodyStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontFamily" Value="Arial"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- Mana Cost Style -->
    <Style x:Key="ManaCostStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource ManaBrush}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontFamily" Value="Arial"/>
    </Style>

</ResourceDictionary>
