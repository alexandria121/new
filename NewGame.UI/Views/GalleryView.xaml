<UserControl x:Class="NewGame.UI.Views.GalleryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:Converters="clr-namespace:NewGame.UI.Converters"
             mc:Ignorable="d"
             Background="{StaticResource BackgroundBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" 
                   Text="Card Gallery" 
                   Style="{StaticResource TitleStyle}"
                   Margin="0,0,0,20"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding MenuCards}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="8"
                                Background="#404040"
                                CornerRadius="10"
                                Padding="12"
                                Width="160"
                                Height="220"
                                BorderBrush="{Binding Element, Converter={StaticResource ElementToGradientConverter}, FallbackValue=#505050}"
                                BorderThickness="3">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Card header with name and mana -->
                                <Grid Grid.Row="0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding ElementEmoji}"
                                                   FontSize="14"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,4,0"/>
                                        <TextBlock Text="{Binding Name}"
                                                   Foreground="White"
                                                   FontSize="10"
                                                   FontWeight="Bold"
                                                   TextWrapping="Wrap"
                                                   MaxWidth="85"/>
                                    </StackPanel>
                                    <Border HorizontalAlignment="Right"
                                            Background="#303060"
                                            CornerRadius="8"
                                            Padding="4,2"
                                            Visibility="{Binding ManaCost, Converter={StaticResource IntToVisibilityConverter}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="◆" Foreground="#80FFFFFF" FontSize="8" Margin="0,0,2,0"/>
                                            <TextBlock Text="{Binding ManaCost}"
                                                       Foreground="White"
                                                       FontSize="10"
                                                       FontWeight="Bold"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Card image placeholder -->
                                <Border Grid.Row="1"
                                        Background="#303030"
                                        Margin="0,8"
                                        CornerRadius="4">
                                    <TextBlock Text="{Binding TypeBadgeSymbol}"
                                               FontSize="36"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="{Binding Element, Converter={StaticResource ElementToColorConverter}}"/>
                                </Border>

                                <!-- Description -->
                                <TextBlock Grid.Row="2"
                                           Text="{Binding Description}"
                                           Foreground="#A0A0A0"
                                           FontSize="8"
                                           TextWrapping="Wrap"
                                           MaxHeight="35"
                                           TextTrimming="CharacterEllipsis"
                                           Visibility="{Binding HasEffects, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                <!-- Type, Rarity and Power/Health -->
                                <Grid Grid.Row="3" Margin="0,4,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding TypeBadgeSymbol}"
                                                   Foreground="{Binding Type, Converter={StaticResource TypeToColorConverter}}"
                                                   FontSize="10"/>
                                        <TextBlock Text="{Binding Type}"
                                                   Foreground="#808080"
                                                   FontSize="8"
                                                   Margin="3,0,0,0"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <!-- Power/Health (creatures only - use IsCreature property) -->
                                        <StackPanel Orientation="Horizontal"
                                            Visibility="{Binding IsCreature, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <Border Background="#303030" CornerRadius="4" Padding="4,1" Margin="0,0,4,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="⚔" Foreground="#FF6464" FontSize="8"/>
                                                    <TextBlock Text="{Binding Power}" Foreground="#FF6464" FontSize="8" FontWeight="Bold" Margin="2,0,0,0"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Background="#303030" CornerRadius="4" Padding="4,1">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="♥" Foreground="#64FF64" FontSize="8"/>
                                                    <TextBlock Text="{Binding Health}" Foreground="#64FF64" FontSize="8" FontWeight="Bold" Margin="2,0,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                        <!-- Rarity (shown when not creature) -->
                                        <StackPanel Orientation="Horizontal"
                                            Visibility="{Binding IsCreature, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                            <TextBlock Text="{Binding RarityGem}"
                                                       Foreground="{Binding Rarity, Converter={StaticResource RarityToColorConverter}}"
                                                       FontSize="10"/>
                                            <TextBlock Text="{Binding RarityName}"
                                                       Foreground="{Binding Rarity, Converter={StaticResource RarityToColorConverter}}"
                                                       FontSize="8"
                                                       Margin="2,0,0,0"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>

    <UserControl.Resources>
        <Converters:TypeToColorConverter x:Key="TypeToColorConverter"/>
        <Converters:ElementToColorConverter x:Key="ElementToColorConverter"/>
        <Converters:ElementToGradientConverter x:Key="ElementToGradientConverter"/>
        <Converters:ElementToGlowConverter x:Key="ElementToGlowConverter"/>
        <Converters:RarityToColorConverter x:Key="RarityToColorConverter"/>
        <Converters:RarityToGradientConverter x:Key="RarityToGradientConverter"/>
        <Converters:RarityToGlowConverter x:Key="RarityToGlowConverter"/>
        <Converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <Converters:CardTypeToStatsVisibilityConverter x:Key="CardTypeToStatsVisibilityConverter"/>
        <Converters:CardTypeHasStatsConverter x:Key="CardTypeHasStatsConverter"/>
    </UserControl.Resources>

</UserControl>
