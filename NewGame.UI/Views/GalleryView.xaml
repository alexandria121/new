<UserControl x:Class="NewGame.UI.Views.GalleryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:Converters="clr-namespace:NewGame.UI.Converters"
             mc:Ignorable="d"
             Background="{StaticResource BackgroundBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" 
                   Text="Card Gallery" 
                   Style="{StaticResource TitleStyle}"
                   Margin="0,0,0,20"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding MenuCards}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- Outer wrapper for element glow effect -->
                        <Border Effect="{Binding Element, Converter={StaticResource ElementToGlowConverter}}"
                                Margin="8">
                            <!-- Inner wrapper for rarity glow -->
                            <Border Effect="{Binding Rarity, Converter={StaticResource RarityToGlowConverter}}">
                                <Border Background="{Binding Element, Converter={StaticResource ElementToColorConverter}}"
                                        BorderBrush="{Binding Element, Converter={StaticResource ElementToGradientConverter}}"
                                        BorderThickness="4"
                                        CornerRadius="10"
                                        Padding="12"
                                        Width="160"
                                        Height="220">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Card header with element color and rarity indicator -->
                                        <Grid Grid.Row="0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding ElementEmoji}"
                                                           FontSize="16"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,6,0"/>
                                                <TextBlock Text="{Binding Name}"
                                                           Foreground="White"
                                                           FontSize="11"
                                                           FontWeight="Bold"
                                                           TextWrapping="Wrap"
                                                           MaxWidth="80"/>
                                            </StackPanel>
                                            <Border HorizontalAlignment="Right"
                                                    Background="{StaticResource ManaBrush}"
                                                    CornerRadius="10"
                                                    Padding="6,2">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="◆" Foreground="#80FFFFFF" FontSize="10" Margin="0,0,2,0"/>
                                                    <TextBlock Text="{Binding ManaCost}"
                                                               Foreground="White"
                                                               FontSize="11"
                                                               FontWeight="Bold"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <!-- Card description area -->
                                        <Border Grid.Row="1"
                                                Background="#40000000"
                                                Margin="0,10,0,10"
                                                CornerRadius="4">
                                            <StackPanel VerticalAlignment="Center" Margin="5">
                                                <TextBlock Text="{Binding Description}"
                                                           Foreground="#C0FFFFFF"
                                                           FontSize="9"
                                                           TextWrapping="Wrap"
                                                           TextAlignment="Center"/>
                                                <!-- Effects indicator -->
                                                <TextBlock Text="{Binding EffectsText}"
                                                           Foreground="{Binding Element, Converter={StaticResource ElementToColorConverter}}"
                                                           FontSize="8"
                                                           TextAlignment="Center"
                                                           Margin="0,5,0,0"
                                                           Visibility="{Binding HasEffects, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Type and rarity info -->
                                        <Grid Grid.Row="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                <TextBlock Text="{Binding TypeBadgeSymbol}"
                                                           Foreground="{Binding Type, Converter={StaticResource TypeToColorConverter}}"
                                                           FontSize="12"/>
                                                <TextBlock Text="{Binding Type}"
                                                           Foreground="#B0B0B0"
                                                           FontSize="9"
                                                           Margin="4,0,0,0"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <TextBlock Text="{Binding RarityGem}"
                                                           Foreground="{Binding Rarity, Converter={StaticResource RarityToColorConverter}}"
                                                           FontSize="12"
                                                           FontWeight="Bold"/>
                                                <TextBlock Text="{Binding RarityText}"
                                                           Foreground="{Binding Rarity, Converter={StaticResource RarityToColorConverter}}"
                                                           FontSize="9"
                                                           Margin="2,0,0,0"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Power and Health stats -->
                                        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,0">
                                            <Border Background="#404040" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="⚔" Foreground="{StaticResource DangerBrush}" FontSize="10"/>
                                                    <TextBlock Text="{Binding Power}" Foreground="{StaticResource DangerBrush}" FontSize="10" FontWeight="Bold"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Background="#404040" CornerRadius="4" Padding="6,2">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="♥" Foreground="{StaticResource HealthBrush}" FontSize="10"/>
                                                    <TextBlock Text="{Binding Health}" Foreground="{StaticResource HealthBrush}" FontSize="10" FontWeight="Bold"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Border>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>

    <UserControl.Resources>
        <Converters:TypeToColorConverter x:Key="TypeToColorConverter"/>
        <Converters:ElementToColorConverter x:Key="ElementToColorConverter"/>
        <Converters:ElementToGradientConverter x:Key="ElementToGradientConverter"/>
        <Converters:ElementToGlowConverter x:Key="ElementToGlowConverter"/>
        <Converters:RarityToColorConverter x:Key="RarityToColorConverter"/>
        <Converters:RarityToGradientConverter x:Key="RarityToGradientConverter"/>
        <Converters:RarityToGlowConverter x:Key="RarityToGlowConverter"/>
        <Converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </UserControl.Resources>

</UserControl>
