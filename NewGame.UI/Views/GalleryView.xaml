<UserControl x:Class="NewGame.UI.Views.GalleryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:Converters="clr-namespace:NewGame.UI.Converters"
             mc:Ignorable="d"
             Background="{StaticResource BackgroundBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" 
                   Text="Card Gallery" 
                   Style="{StaticResource TitleStyle}"
                   Margin="0,0,0,20"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding MenuCards}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{Binding Element, Converter={StaticResource ElementToColorConverter}}"
                                BorderBrush="{Binding Type, Converter={StaticResource TypeToColorConverter}}"
                                BorderThickness="3"
                                CornerRadius="8"
                                Padding="12"
                                Margin="8"
                                Width="160"
                                Height="220">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <TextBlock Text="{Binding Name}"
                                               Foreground="White"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               TextWrapping="Wrap"/>
                                    <Border HorizontalAlignment="Right"
                                            Background="{StaticResource ManaBrush}"
                                            CornerRadius="10"
                                            Padding="6,2">
                                        <TextBlock Text="{Binding ManaCost}"
                                                   Foreground="White"
                                                   FontSize="11"
                                                   FontWeight="Bold"/>
                                    </Border>
                                </Grid>

                                <Border Grid.Row="1"
                                        Background="#40000000"
                                        Margin="0,10,0,10"
                                        CornerRadius="4">
                                    <TextBlock Text="{Binding Description}"
                                               Foreground="#C0FFFFFF"
                                               FontSize="9"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center"
                                               Padding="5"/>
                                </Border>

                                <StackPanel Grid.Row="2" Orientation="Horizontal">
                                    <TextBlock Text="{Binding Type}"
                                               Foreground="#B0B0B0"
                                               FontSize="10"/>
                                    <TextBlock Text=" | " Foreground="#606060"/>
                                    <TextBlock Text="{Binding RarityText}"
                                               Foreground="{Binding Rarity, Converter={StaticResource RarityToColorConverter}}"
                                               FontSize="10"/>
                                </StackPanel>

                                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,5,0,0">
                                    <TextBlock Text="PWR:" Foreground="#FF9632" FontSize="10"/>
                                    <TextBlock Text="{Binding Power}" Foreground="#FF9632" FontSize="10" FontWeight="Bold"/>
                                    <TextBlock Text=" HP:" Foreground="#64FF64" FontSize="10" Margin="10,0,0,0"/>
                                    <TextBlock Text="{Binding Health}" Foreground="#64FF64" FontSize="10" FontWeight="Bold"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>

    <UserControl.Resources>
        <Converters:TypeToColorConverter x:Key="TypeToColorConverter"/>
        <Converters:ElementToColorConverter x:Key="ElementToColorConverter"/>
        <Converters:RarityToColorConverter x:Key="RarityToColorConverter"/>
    </UserControl.Resources>

</UserControl>
