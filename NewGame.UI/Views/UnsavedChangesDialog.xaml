<Window x:Class="NewGame.UI.Views.UnsavedChangesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Unsaved Changes"
        Width="400" 
        Height="200"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource BackgroundBrush}">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Message -->
        <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="You have unsaved changes!" 
                       Foreground="{StaticResource TextPrimaryBrush}"
                       FontWeight="Bold"
                       FontSize="16"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,10"/>
            <TextBlock Text="Do you want to save before leaving?"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="14"
                       HorizontalAlignment="Center"/>
        </StackPanel>
        
        <!-- Buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
            <Button Content="Save and Exit" 
                    Style="{StaticResource AccentButtonStyle}"
                    Padding="15,8"
                    Margin="5"
                    Click="SaveAndExit_Click"/>
            <Button Content="Discard" 
                    Style="{StaticResource DangerButtonStyle}"
                    Padding="15,8"
                    Margin="5"
                    Click="Discard_Click"/>
            <Button Content="Cancel" 
                    Style="{StaticResource BaseButtonStyle}"
                    Padding="15,8"
                    Margin="5"
                    Click="Cancel_Click"
                    IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
