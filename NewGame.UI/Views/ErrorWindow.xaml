<Window x:Class="NewGame.UI.Views.ErrorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Something Went Wrong"
        Height="450" 
        Width="600"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E2E"
        ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <Style x:Key="BaseTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
        <Style x:Key="ButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#3B82F6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="4" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2563EB"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonStyle}">
            <Setter Property="Background" Value="#4B5563"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#6B7280"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <TextBlock Text="⚠️" FontSize="32" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <TextBlock Text="Something Went Wrong" 
                       Style="{StaticResource BaseTextStyle}" 
                       FontSize="24" 
                       FontWeight="Bold"
                       VerticalAlignment="Center"/>
        </StackPanel>
        
        <!-- Error Summary -->
        <StackPanel Grid.Row="1" Margin="0,0,0,16">
            <TextBlock Text="An unexpected error occurred." 
                       Style="{StaticResource BaseTextStyle}" 
                       FontSize="14"
                       Margin="0,0,0,8"/>
            <TextBlock x:Name="ErrorSummaryText" 
                       Style="{StaticResource BaseTextStyle}" 
                       FontSize="12"
                       Foreground="#F87171"
                       TextWrapping="Wrap"/>
        </StackPanel>
        
        <!-- Stack Trace -->
        <Border Grid.Row="2" 
                Background="#0D0D0D" 
                CornerRadius="8" 
                Padding="16"
                BorderBrush="#374151"
                BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <TextBlock x:Name="StackTraceText" 
                           Style="{StaticResource BaseTextStyle}" 
                           FontFamily="Consolas"
                           FontSize="11"
                           TextWrapping="Wrap"/>
            </ScrollViewer>
        </Border>
        
        <!-- Buttons -->
        <StackPanel Grid.Row="3" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="Open Log File" 
                    Style="{StaticResource SecondaryButtonStyle}"
                    Click="OpenLogFile_Click"
                    Margin="0,0,12,0"/>
            <Button Content="Copy to Clipboard" 
                    Style="{StaticResource SecondaryButtonStyle}"
                    Click="CopyToClipboard_Click"
                    Margin="0,0,12,0"/>
            <Button Content="Close" 
                    Style="{StaticResource ButtonStyle}"
                    Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
