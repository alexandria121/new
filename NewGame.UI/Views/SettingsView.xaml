<UserControl x:Class="NewGame.UI.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="{StaticResource BackgroundBrush}">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" 
                   Text="Settings" 
                   Style="{StaticResource TitleStyle}"
                   Margin="0,0,0,30"/>

        <!-- Settings Options -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Sound Settings -->
                <Border Background="{StaticResource SurfaceBrush}"
                        CornerRadius="8"
                        Padding="20"
                        Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Sound" 
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Margin="0,0,0,15"/>
                        
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Master Volume" 
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"/>
                            <Slider Grid.Column="1" 
                                   Minimum="0" Maximum="100" 
                                   Value="80"
                                   Width="200"
                                   HorizontalAlignment="Left"/>
                        </Grid>
                        
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Music Volume" 
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"/>
                            <Slider Grid.Column="1" 
                                   Minimum="0" Maximum="100" 
                                   Value="70"
                                   Width="200"
                                   HorizontalAlignment="Left"/>
                        </Grid>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Sound Effects" 
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"/>
                            <CheckBox Grid.Column="1" 
                                     Content="Enable Sound Effects" 
                                     IsChecked="True"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Graphics Settings -->
                <Border Background="{StaticResource SurfaceBrush}"
                        CornerRadius="8"
                        Padding="20"
                        Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Graphics" 
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Margin="0,0,0,15"/>
                        
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Resolution" 
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1" 
                                     Width="150"
                                     HorizontalAlignment="Left">
                                <ComboBoxItem Content="1920x1080" IsSelected="True"/>
                                <ComboBoxItem Content="1280x720"/>
                                <ComboBoxItem Content="2560x1440"/>
                            </ComboBox>
                        </Grid>
                        
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Fullscreen" 
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"/>
                            <CheckBox Grid.Column="1" 
                                     Content="Enable Fullscreen"/>
                        </Grid>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Vsync" 
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"/>
                            <CheckBox Grid.Column="1" 
                                     Content="Enable Vsync"
                                     IsChecked="True"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Gameplay Settings -->
                <Border Background="{StaticResource SurfaceBrush}"
                        CornerRadius="8"
                        Padding="20"
                        Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Gameplay" 
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Margin="0,0,0,15"/>
                        
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Animation Speed" 
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1" 
                                     Width="150"
                                     HorizontalAlignment="Left">
                                <ComboBoxItem Content="Normal" IsSelected="True"/>
                                <ComboBoxItem Content="Fast"/>
                                <ComboBoxItem Content="Instant"/>
                            </ComboBox>
                        </Grid>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Tutorial Hints" 
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"/>
                            <CheckBox Grid.Column="1" 
                                     Content="Show Tutorial Hints"
                                     IsChecked="True"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Back Button -->
        <Button Grid.Row="2"
                Content="Back to Menu"
                Style="{StaticResource PrimaryButtonStyle}"
                Command="{Binding NavigateCommand}"
                CommandParameter="Menu"
                Height="50"
                Width="150"
                HorizontalAlignment="Left"
                Margin="0,20,0,0"/>
    </Grid>
</UserControl>