<UserControl x:Class="NewGame.UI.Views.GameView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:NewGame.UI.ViewModels"
             xmlns:controls="clr-namespace:NewGame.UI.Controls"
             xmlns:Converters="clr-namespace:NewGame.UI.Converters"
             mc:Ignorable="d"
             Background="{StaticResource BackgroundBrush}">

    <UserControl.Resources>
        <Converters:BoolToTurnTextConverter x:Key="BoolToTurnTextConverter"/>
        <Converters:BoolToTurnColorConverter x:Key="BoolToTurnColorConverter"/>
        <Converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <Converters:CanAffordToOpacityConverter x:Key="CanAffordToOpacityConverter"/>
        <Converters:CanAffordToColorConverter x:Key="CanAffordToColorConverter"/>
        <Converters:ElementToColorConverter x:Key="ElementToColorConverter"/>
        <Converters:ElementToGradientConverter x:Key="ElementToGradientConverter"/>
        <Converters:ElementToGlowConverter x:Key="ElementToGlowConverter"/>
        <Converters:TypeToColorConverter x:Key="TypeToColorConverter"/>
        <Converters:EffectTypeToIconConverter x:Key="EffectTypeToIconConverter"/>
        <Converters:IntToVisibilityConverter x:Key="IntToVisibilityConverter"/>
        <Converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <Converters:RarityToGradientConverter x:Key="RarityToGradientConverter"/>
        <Converters:RarityToGlowConverter x:Key="RarityToGlowConverter"/>

        <!-- Enhanced Card Border Style with Element Glow -->
        <Style x:Key="ElementCardStyle" TargetType="Border">
            <Setter Property="BorderThickness" Value="4"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Margin" Value="4"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Bar: Turn Info & Status -->
        <Border Grid.Row="0" 
                Background="{StaticResource SurfaceBrush}" 
                CornerRadius="6"
                Padding="15,10"
                Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Grid.Column="0">
                    <TextBlock Text="Turn " Foreground="{StaticResource TextPrimaryBrush}" FontSize="14"/>
                    <TextBlock Text="{Binding TurnCount}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="14" FontWeight="Bold"/>
                    <TextBlock Text=" | " Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding IsPlayerTurn, Converter={StaticResource BoolToTurnTextConverter}}"
                               Foreground="{Binding IsPlayerTurn, Converter={StaticResource BoolToTurnColorConverter}}"
                               FontSize="14" FontWeight="Bold"/>
                </StackPanel>

                <TextBlock Grid.Column="1"
                           Text="{Binding StatusMessage}"
                           Foreground="{StaticResource AccentBrush}"
                           FontSize="13"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="20,0">
                    <TextBlock Text="You: " Foreground="{StaticResource HealthBrush}" FontSize="12"/>
                    <TextBlock Text="{Binding PlayerHealth}" Foreground="{StaticResource HealthBrush}" FontSize="12" FontWeight="Bold"/>
                    <TextBlock Text="/" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding PlayerMaxHealth}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                    <TextBlock Text=" | " Foreground="{StaticResource TextSecondaryBrush}" Margin="10,0"/>
                    <TextBlock Text="Enemy: " Foreground="{StaticResource DangerBrush}" FontSize="12"/>
                    <TextBlock Text="{Binding OpponentHealth}" Foreground="{StaticResource DangerBrush}" FontSize="12" FontWeight="Bold"/>
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="20,0">
                    <TextBlock Text="Mana: " Foreground="{StaticResource ManaBrush}" FontSize="14"/>
                    <TextBlock Text="{Binding PlayerMana}" Foreground="{StaticResource ManaBrush}" FontSize="14" FontWeight="Bold"/>
                    <TextBlock Text="/" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding PlayerMaxMana}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="14"/>
                </StackPanel>

                <Button Grid.Column="4"
                        Content="End Turn"
                        Style="{StaticResource AccentButtonStyle}"
                        Command="{Binding EndTurnCommand}"
                        Padding="20,8"/>
            </Grid>
        </Border>

        <!-- Opponent Area -->
        <Border Grid.Row="1" 
                Background="{StaticResource SurfaceBrush}" 
                CornerRadius="6"
                Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" 
                           Text="Opponent" 
                           Foreground="{StaticResource DangerBrush}"
                           FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>

                <UniformGrid Grid.Row="1" Rows="1" Columns="6">
                    <Border Background="#503232" BorderBrush="#604040" BorderThickness="1" Margin="3" CornerRadius="4" Tag="0">
                        <Grid>
                            <TextBlock Text="O1" Foreground="#606060" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                            <Border Background="#3A2828" CornerRadius="3" Margin="2" 
                                    Visibility="{Binding FieldSlots[0], Converter={StaticResource NullToVisibilityConverter}}">
                                <StackPanel VerticalAlignment="Center" Margin="2">
                                    <TextBlock Text="{Binding FieldSlots[0].Card.Name}" Foreground="#FF6464" FontSize="8" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0">
                                        <TextBlock Text="P:" Foreground="#FF9632" FontSize="7"/>
                                        <TextBlock Text="{Binding FieldSlots[0].Card.Power}" Foreground="#FF9632" FontSize="7" FontWeight="Bold"/>
                                        <TextBlock Text=" H:" Foreground="#64FF64" FontSize="7"/>
                                        <TextBlock Text="{Binding FieldSlots[0].Card.Health}" Foreground="#64FF64" FontSize="7" FontWeight="Bold"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding FieldSlots[0].EffectsText}"
                                               Foreground="{StaticResource AccentBrush}"
                                               FontSize="6"
                                               TextAlignment="Center"
                                               Margin="0,1,0,0"
                                               Visibility="{Binding FieldSlots[0].HasEffects, Converter={StaticResource NullToVisibilityConverter}}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                    <Border Background="#503232" BorderBrush="#604040" BorderThickness="1" Margin="3" CornerRadius="4" Tag="1">
                        <Grid>
                            <TextBlock Text="O2" Foreground="#606060" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                            <Border Background="#3A2828" CornerRadius="3" Margin="2"
                                    Visibility="{Binding FieldSlots[1], Converter={StaticResource NullToVisibilityConverter}}">
                                <StackPanel VerticalAlignment="Center" Margin="2">
                                    <TextBlock Text="{Binding FieldSlots[1].Card.Name}" Foreground="#FF6464" FontSize="8" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0">
                                        <TextBlock Text="P:" Foreground="#FF9632" FontSize="7"/>
                                        <TextBlock Text="{Binding FieldSlots[1].Card.Power}" Foreground="#FF9632" FontSize="7" FontWeight="Bold"/>
                                        <TextBlock Text=" H:" Foreground="#64FF64" FontSize="7"/>
                                        <TextBlock Text="{Binding FieldSlots[1].Card.Health}" Foreground="#64FF64" FontSize="7" FontWeight="Bold"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding FieldSlots[1].EffectsText}"
                                               Foreground="{StaticResource AccentBrush}"
                                               FontSize="6"
                                               TextAlignment="Center"
                                               Margin="0,1,0,0"
                                               Visibility="{Binding FieldSlots[1].HasEffects, Converter={StaticResource NullToVisibilityConverter}}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                    <Border Background="#503232" BorderBrush="#604040" BorderThickness="1" Margin="3" CornerRadius="4" Tag="2">
                        <Grid>
                            <TextBlock Text="O3" Foreground="#606060" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                            <Border Background="#3A2828" CornerRadius="3" Margin="2"
                                    Visibility="{Binding FieldSlots[2], Converter={StaticResource NullToVisibilityConverter}}">
                                <StackPanel VerticalAlignment="Center" Margin="2">
                                    <TextBlock Text="{Binding FieldSlots[2].Card.Name}" Foreground="#FF6464" FontSize="8" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0">
                                        <TextBlock Text="P:" Foreground="#FF9632" FontSize="7"/>
                                        <TextBlock Text="{Binding FieldSlots[2].Card.Power}" Foreground="#FF9632" FontSize="7" FontWeight="Bold"/>
                                        <TextBlock Text=" H:" Foreground="#64FF64" FontSize="7"/>
                                        <TextBlock Text="{Binding FieldSlots[2].Card.Health}" Foreground="#64FF64" FontSize="7" FontWeight="Bold"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding FieldSlots[2].EffectsText}"
                                               Foreground="{StaticResource AccentBrush}"
                                               FontSize="6"
                                               TextAlignment="Center"
                                               Margin="0,1,0,0"
                                               Visibility="{Binding FieldSlots[2].HasEffects, Converter={StaticResource NullToVisibilityConverter}}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                    <Border Background="#503232" BorderBrush="#604040" BorderThickness="1" Margin="3" CornerRadius="4" Tag="3">
                        <Grid>
                            <TextBlock Text="O4" Foreground="#606060" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                            <Border Background="#3A2828" CornerRadius="3" Margin="2"
                                    Visibility="{Binding FieldSlots[3], Converter={StaticResource NullToVisibilityConverter}}">
                                <StackPanel VerticalAlignment="Center" Margin="2">
                                    <TextBlock Text="{Binding FieldSlots[3].Card.Name}" Foreground="#FF6464" FontSize="8" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0">
                                        <TextBlock Text="P:" Foreground="#FF9632" FontSize="7"/>
                                        <TextBlock Text="{Binding FieldSlots[3].Card.Power}" Foreground="#FF9632" FontSize="7" FontWeight="Bold"/>
                                        <TextBlock Text=" H:" Foreground="#64FF64" FontSize="7"/>
                                        <TextBlock Text="{Binding FieldSlots[3].Card.Health}" Foreground="#64FF64" FontSize="7" FontWeight="Bold"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding FieldSlots[3].EffectsText}"
                                               Foreground="{StaticResource AccentBrush}"
                                               FontSize="6"
                                               TextAlignment="Center"
                                               Margin="0,1,0,0"
                                               Visibility="{Binding FieldSlots[3].HasEffects, Converter={StaticResource NullToVisibilityConverter}}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                    <Border Background="#503232" BorderBrush="#604040" BorderThickness="1" Margin="3" CornerRadius="4" Tag="4">
                        <Grid>
                            <TextBlock Text="O5" Foreground="#606060" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                            <Border Background="#3A2828" CornerRadius="3" Margin="2"
                                    Visibility="{Binding FieldSlots[4], Converter={StaticResource NullToVisibilityConverter}}">
                                <StackPanel VerticalAlignment="Center" Margin="2">
                                    <TextBlock Text="{Binding FieldSlots[4].Card.Name}" Foreground="#FF6464" FontSize="8" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0">
                                        <TextBlock Text="P:" Foreground="#FF9632" FontSize="7"/>
                                        <TextBlock Text="{Binding FieldSlots[4].Card.Power}" Foreground="#FF9632" FontSize="7" FontWeight="Bold"/>
                                        <TextBlock Text=" H:" Foreground="#64FF64" FontSize="7"/>
                                        <TextBlock Text="{Binding FieldSlots[4].Card.Health}" Foreground="#64FF64" FontSize="7" FontWeight="Bold"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding FieldSlots[4].EffectsText}"
                                               Foreground="{StaticResource AccentBrush}"
                                               FontSize="6"
                                               TextAlignment="Center"
                                               Margin="0,1,0,0"
                                               Visibility="{Binding FieldSlots[4].HasEffects, Converter={StaticResource NullToVisibilityConverter}}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                    <Border Background="#503232" BorderBrush="#604040" BorderThickness="1" Margin="3" CornerRadius="4" Tag="5">
                        <Grid>
                            <TextBlock Text="O6" Foreground="#606060" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                            <Border Background="#3A2828" CornerRadius="3" Margin="2"
                                    Visibility="{Binding FieldSlots[5], Converter={StaticResource NullToVisibilityConverter}}">
                                <StackPanel VerticalAlignment="Center" Margin="2">
                                    <TextBlock Text="{Binding FieldSlots[5].Card.Name}" Foreground="#FF6464" FontSize="8" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0">
                                        <TextBlock Text="P:" Foreground="#FF9632" FontSize="7"/>
                                        <TextBlock Text="{Binding FieldSlots[5].Card.Power}" Foreground="#FF9632" FontSize="7" FontWeight="Bold"/>
                                        <TextBlock Text=" H:" Foreground="#64FF64" FontSize="7"/>
                                        <TextBlock Text="{Binding FieldSlots[5].Card.Health}" Foreground="#64FF64" FontSize="7" FontWeight="Bold"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding FieldSlots[5].EffectsText}"
                                               Foreground="{StaticResource AccentBrush}"
                                               FontSize="6"
                                               TextAlignment="Center"
                                               Margin="0,1,0,0"
                                               Visibility="{Binding FieldSlots[5].HasEffects, Converter={StaticResource NullToVisibilityConverter}}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </UniformGrid>
            </Grid>
        </Border>

        <!-- Player Hand Section -->
        <Border Grid.Row="2" 
                Background="{StaticResource SurfaceBrush}" 
                CornerRadius="6"
                Padding="10"
                Margin="0,10,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" 
                           Text="Your Hand" 
                           Foreground="{StaticResource AccentBrush}"
                           FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>

                <ScrollViewer Grid.Row="1" 
                              HorizontalScrollBarVisibility="Auto" 
                              VerticalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding PlayerHand}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- Outer wrapper for glow effect -->
                                <Border Effect="{Binding Card.Element, Converter={StaticResource ElementToGlowConverter}}"
                                        Margin="4">
                                    <!-- Inner wrapper for rarity glow -->
                                    <Border Effect="{Binding Card.Rarity, Converter={StaticResource RarityToGlowConverter}}">
                                        <Border Background="{StaticResource SurfaceLightBrush}" 
                                                BorderBrush="{Binding Card.Element, Converter={StaticResource ElementToGradientConverter}}" 
                                                BorderThickness="4" 
                                                CornerRadius="8"
                                                Width="120"
                                                Height="160"
                                                Opacity="1"
                                                MouseMove="OnHandCardMouseMove"
                                                MouseRightButtonDown="OnHandCardRightClick"
                                                Tag="{Binding}"
                                                Cursor="Hand">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                
                                                <!-- Type Badge in top-left corner with element color -->
                                                <Border Grid.Row="0" 
                                                        Background="{Binding Card.Element, Converter={StaticResource ElementToColorConverter}}"
                                                        CornerRadius="6,6,0,0" 
                                                        Padding="5,3">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding Card.ManaCost}" 
                                                                   Foreground="White"
                                                                   FontSize="12" FontWeight="Bold"
                                                                   HorizontalAlignment="Center"/>
                                                        <!-- Rarity gem indicator -->
                                                        <TextBlock Grid.Column="1" 
                                                                   Text="{Binding Card.Rarity, Converter={StaticResource RarityToColorConverter}}"
                                                                   FontSize="10"
                                                                   Margin="2,0"
                                                                   VerticalAlignment="Center"/>
                                                        <!-- Type Badge Symbol -->
                                                        <Border Grid.Column="2" 
                                                                Background="#202020"
                                                                CornerRadius="10"
                                                                Padding="4,2"
                                                                ToolTip="{Binding TypeBadgeTooltip}">
                                                            <TextBlock Text="{Binding TypeBadgeSymbol}" 
                                                                       FontSize="10"
                                                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                                
                                                <!-- Card content area with element-colored header -->
                                                <Border Grid.Row="1" 
                                                        Background="#383838" 
                                                        Margin="6"
                                                        CornerRadius="4">
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Card.Name}" 
                                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                                   FontSize="11" 
                                                                   FontWeight="Bold"
                                                                   TextWrapping="Wrap"
                                                                   TextAlignment="Center"
                                                                   Margin="4"/>
                                                        <!-- Element indicator -->
                                                        <TextBlock Text="{Binding ElementEmoji}"
                                                                   FontSize="14"
                                                                   HorizontalAlignment="Center"
                                                                   Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                                
                                                <StackPanel Grid.Row="2" Orientation="Vertical" HorizontalAlignment="Center" Margin="5,0,5,6">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                        <TextBlock Text="PWR:" Foreground="{StaticResource DangerBrush}" FontSize="10"/>
                                                        <TextBlock Text="{Binding Card.Power}" Foreground="{StaticResource DangerBrush}" FontSize="10" Margin="0,0,10,0"/>
                                                        <TextBlock Text="HP:" Foreground="{StaticResource HealthBrush}" FontSize="10"/>
                                                        <TextBlock Text="{Binding Card.Health}" Foreground="{StaticResource HealthBrush}" FontSize="10"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding EffectsText}"
                                                               Foreground="{Binding Card.Element, Converter={StaticResource ElementToColorConverter}}"
                                                               FontSize="8"
                                                               TextAlignment="Center"
                                                               Margin="0,2,0,0"
                                                               Visibility="{Binding HasEffects, Converter={StaticResource NullToVisibilityConverter}}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </Border>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Playing Field Label -->
        <TextBlock Grid.Row="3" 
                   Text="Playing Field" 
                   Foreground="{StaticResource TextSecondaryBrush}"
                   FontSize="12"
                   Margin="0,10"
                   HorizontalAlignment="Center"/>

        <!-- Player Field Area -->
        <Border Grid.Row="4" 
                Background="#324632" 
                CornerRadius="6"
                Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="280"/>
                </Grid.ColumnDefinitions>

                <!-- Player Field Slots -->
                <UniformGrid Grid.Column="0" Rows="1" Columns="6" VerticalAlignment="Center">
                    <Border x:Name="Slot0" 
                            Background="#465046" 
                            BorderBrush="#506050" 
                            BorderThickness="2" 
                            Margin="4" 
                            CornerRadius="6"
                            AllowDrop="True"
                            Drop="OnSlotDrop"
                            DragEnter="OnSlotDragEnter"
                            DragLeave="OnSlotDragLeave"
                            MouseMove="OnSlotMouseMove"
                            Tag="6">
                        <Grid>
                            <TextBlock Text="P1" Foreground="#606060" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                            <Border Background="#384638" CornerRadius="4" Margin="2"
                                    Visibility="{Binding FieldSlots[6], Converter={StaticResource NullToVisibilityConverter}}"
                                    MouseRightButtonDown="OnFieldCardRightClick"
                                    Tag="{Binding FieldSlots[6]}">
                                <StackPanel VerticalAlignment="Center" Margin="2">
                                    <TextBlock Text="{Binding FieldSlots[6].Card.Name}" Foreground="#64FF64" FontSize="9" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0">
                                        <TextBlock Text="P:" Foreground="#FF9632" FontSize="8"/>
                                        <TextBlock Text="{Binding FieldSlots[6].Card.Power}" Foreground="#FF9632" FontSize="8" FontWeight="Bold"/>
                                        <TextBlock Text=" H:" Foreground="#64FF64" FontSize="8"/>
                                        <TextBlock Text="{Binding FieldSlots[6].Card.Health}" Foreground="#64FF64" FontSize="8" FontWeight="Bold"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding FieldSlots[6].EffectsText}"
                                               Foreground="{StaticResource AccentBrush}"
                                               FontSize="7"
                                               TextAlignment="Center"
                                               Margin="0,1,0,0"
                                               Visibility="{Binding FieldSlots[6].HasEffects, Converter={StaticResource NullToVisibilityConverter}}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                    <Border x:Name="Slot1" 
                            Background="#465046" 
                            BorderBrush="#506050" 
                            BorderThickness="2" 
                            Margin="4" 
                            CornerRadius="6"
                            AllowDrop="True"
                            Drop="OnSlotDrop"
                            DragEnter="OnSlotDragEnter"
                            DragLeave="OnSlotDragLeave"
                            MouseMove="OnSlotMouseMove"
                            Tag="7">
                        <Grid>
                            <TextBlock Text="P2" Foreground="#606060" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                            <Border Background="#384638" CornerRadius="4" Margin="2"
                                    Visibility="{Binding FieldSlots[7], Converter={StaticResource NullToVisibilityConverter}}"
                                    MouseRightButtonDown="OnFieldCardRightClick"
                                    Tag="{Binding FieldSlots[7]}">
                                <StackPanel VerticalAlignment="Center" Margin="2">
                                    <TextBlock Text="{Binding FieldSlots[7].Card.Name}" Foreground="#64FF64" FontSize="9" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0">
                                        <TextBlock Text="P:" Foreground="#FF9632" FontSize="8"/>
                                        <TextBlock Text="{Binding FieldSlots[7].Card.Power}" Foreground="#FF9632" FontSize="8" FontWeight="Bold"/>
                                        <TextBlock Text=" H:" Foreground="#64FF64" FontSize="8"/>
                                        <TextBlock Text="{Binding FieldSlots[7].Card.Health}" Foreground="#64FF64" FontSize="8" FontWeight="Bold"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding FieldSlots[7].EffectsText}"
                                               Foreground="{StaticResource AccentBrush}"
                                               FontSize="7"
                                               TextAlignment="Center"
                                               Margin="0,1,0,0"
                                               Visibility="{Binding FieldSlots[7].HasEffects, Converter={StaticResource NullToVisibilityConverter}}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                    <Border x:Name="Slot2" 
                            Background="#465046" 
                            BorderBrush="#506050" 
                            BorderThickness="2" 
                            Margin="4" 
                            CornerRadius="6"
                            AllowDrop="True"
                            Drop="OnSlotDrop"
                            DragEnter="OnSlotDragEnter"
                            DragLeave="OnSlotDragLeave"
                            MouseMove="OnSlotMouseMove"
                            Tag="8">
                        <Grid>
                            <TextBlock Text="P3" Foreground="#606060" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                            <Border Background="#384638" CornerRadius="4" Margin="2"
                                    Visibility="{Binding FieldSlots[8], Converter={StaticResource NullToVisibilityConverter}}"
                                    MouseRightButtonDown="OnFieldCardRightClick"
                                    Tag="{Binding FieldSlots[8]}">
                                <StackPanel VerticalAlignment="Center" Margin="2">
                                    <TextBlock Text="{Binding FieldSlots[8].Card.Name}" Foreground="#64FF64" FontSize="9" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0">
                                        <TextBlock Text="P:" Foreground="#FF9632" FontSize="8"/>
                                        <TextBlock Text="{Binding FieldSlots[8].Card.Power}" Foreground="#FF9632" FontSize="8" FontWeight="Bold"/>
                                        <TextBlock Text=" H:" Foreground="#64FF64" FontSize="8"/>
                                        <TextBlock Text="{Binding FieldSlots[8].Card.Health}" Foreground="#64FF64" FontSize="8" FontWeight="Bold"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding FieldSlots[8].EffectsText}"
                                               Foreground="{StaticResource AccentBrush}"
                                               FontSize="7"
                                               TextAlignment="Center"
                                               Margin="0,1,0,0"
                                               Visibility="{Binding FieldSlots[8].HasEffects, Converter={StaticResource NullToVisibilityConverter}}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                    <Border x:Name="Slot3" 
                            Background="#465046" 
                            BorderBrush="#506050" 
                            BorderThickness="2" 
                            Margin="4" 
                            CornerRadius="6"
                            AllowDrop="True"
                            Drop="OnSlotDrop"
                            DragEnter="OnSlotDragEnter"
                            DragLeave="OnSlotDragLeave"
                            MouseMove="OnSlotMouseMove"
                            Tag="9">
                        <Grid>
                            <TextBlock Text="P4" Foreground="#606060" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                            <Border Background="#384638" CornerRadius="4" Margin="2"
                                    Visibility="{Binding FieldSlots[9], Converter={StaticResource NullToVisibilityConverter}}"
                                    MouseRightButtonDown="OnFieldCardRightClick"
                                    Tag="{Binding FieldSlots[9]}">
                                <StackPanel VerticalAlignment="Center" Margin="2">
                                    <TextBlock Text="{Binding FieldSlots[9].Card.Name}" Foreground="#64FF64" FontSize="9" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0">
                                        <TextBlock Text="P:" Foreground="#FF9632" FontSize="8"/>
                                        <TextBlock Text="{Binding FieldSlots[9].Card.Power}" Foreground="#FF9632" FontSize="8" FontWeight="Bold"/>
                                        <TextBlock Text=" H:" Foreground="#64FF64" FontSize="8"/>
                                        <TextBlock Text="{Binding FieldSlots[9].Card.Health}" Foreground="#64FF64" FontSize="8" FontWeight="Bold"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding FieldSlots[9].EffectsText}"
                                               Foreground="{StaticResource AccentBrush}"
                                               FontSize="7"
                                               TextAlignment="Center"
                                               Margin="0,1,0,0"
                                               Visibility="{Binding FieldSlots[9].HasEffects, Converter={StaticResource NullToVisibilityConverter}}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                    <Border x:Name="Slot4" 
                            Background="#465046" 
                            BorderBrush="#506050" 
                            BorderThickness="2" 
                            Margin="4" 
                            CornerRadius="6"
                            AllowDrop="True"
                            Drop="OnSlotDrop"
                            DragEnter="OnSlotDragEnter"
                            DragLeave="OnSlotDragLeave"
                            MouseMove="OnSlotMouseMove"
                            Tag="10">
                        <Grid>
                            <TextBlock Text="P5" Foreground="#606060" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                            <Border Background="#384638" CornerRadius="4" Margin="2"
                                    Visibility="{Binding FieldSlots[10], Converter={StaticResource NullToVisibilityConverter}}"
                                    MouseRightButtonDown="OnFieldCardRightClick"
                                    Tag="{Binding FieldSlots[10]}">
                                <StackPanel VerticalAlignment="Center" Margin="2">
                                    <TextBlock Text="{Binding FieldSlots[10].Card.Name}" Foreground="#64FF64" FontSize="9" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0">
                                        <TextBlock Text="P:" Foreground="#FF9632" FontSize="8"/>
                                        <TextBlock Text="{Binding FieldSlots[10].Card.Power}" Foreground="#FF9632" FontSize="8" FontWeight="Bold"/>
                                        <TextBlock Text=" H:" Foreground="#64FF64" FontSize="8"/>
                                        <TextBlock Text="{Binding FieldSlots[10].Card.Health}" Foreground="#64FF64" FontSize="8" FontWeight="Bold"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding FieldSlots[10].EffectsText}"
                                               Foreground="{StaticResource AccentBrush}"
                                               FontSize="7"
                                               TextAlignment="Center"
                                               Margin="0,1,0,0"
                                               Visibility="{Binding FieldSlots[10].HasEffects, Converter={StaticResource NullToVisibilityConverter}}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                    <Border x:Name="Slot5" 
                            Background="#465046" 
                            BorderBrush="#506050" 
                            BorderThickness="2" 
                            Margin="4" 
                            CornerRadius="6"
                            AllowDrop="True"
                            Drop="OnSlotDrop"
                            DragEnter="OnSlotDragEnter"
                            DragLeave="OnSlotDragLeave"
                            MouseMove="OnSlotMouseMove"
                            Tag="11">
                        <Grid>
                            <TextBlock Text="P6" Foreground="#606060" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                            <Border Background="#384638" CornerRadius="4" Margin="2"
                                    Visibility="{Binding FieldSlots[11], Converter={StaticResource NullToVisibilityConverter}}"
                                    MouseRightButtonDown="OnFieldCardRightClick"
                                    Tag="{Binding FieldSlots[11]}">
                                <StackPanel VerticalAlignment="Center" Margin="2">
                                    <TextBlock Text="{Binding FieldSlots[11].Card.Name}" Foreground="#64FF64" FontSize="9" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0">
                                        <TextBlock Text="P:" Foreground="#FF9632" FontSize="8"/>
                                        <TextBlock Text="{Binding FieldSlots[11].Card.Power}" Foreground="#FF9632" FontSize="8" FontWeight="Bold"/>
                                        <TextBlock Text=" H:" Foreground="#64FF64" FontSize="8"/>
                                        <TextBlock Text="{Binding FieldSlots[11].Card.Health}" Foreground="#64FF64" FontSize="8" FontWeight="Bold"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding FieldSlots[11].EffectsText}"
                                               Foreground="{StaticResource AccentBrush}"
                                               FontSize="7"
                                               TextAlignment="Center"
                                               Margin="0,1,0,0"
                                               Visibility="{Binding FieldSlots[11].HasEffects, Converter={StaticResource NullToVisibilityConverter}}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </UniformGrid>

                <!-- Combo Area -->
                <Border Grid.Column="1" 
                        Background="{StaticResource SurfaceBrush}" 
                        CornerRadius="6"
                        Padding="10"
                        Margin="10,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" 
                                   Text="Card Combine" 
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="14" FontWeight="Bold"
                                   HorizontalAlignment="Center"/>

                        <Grid Grid.Row="1" Margin="0,15,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border x:Name="ComboSlot1" 
                                    Grid.Column="0"
                                    Background="#464646" 
                                    BorderBrush="#505050" 
                                    BorderThickness="2" 
                                    Margin="5" 
                                    CornerRadius="6"
                                    Height="80"
                                    AllowDrop="True"
                                    Drop="OnComboSlot1Drop"
                                    DragEnter="OnComboSlotDragEnter"
                                    DragLeave="OnComboSlotDragLeave">
                                <TextBlock Text="1" Foreground="#606060" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20"/>
                            </Border>

                            <Border x:Name="ComboSlot2" 
                                    Grid.Column="1"
                                    Background="#464646" 
                                    BorderBrush="#505050" 
                                    BorderThickness="2" 
                                    Margin="5" 
                                    CornerRadius="6"
                                    Height="80"
                                    AllowDrop="True"
                                    Drop="OnComboSlot2Drop"
                                    DragEnter="OnComboSlotDragEnter"
                                    DragLeave="OnComboSlotDragLeave">
                                <TextBlock Text="2" Foreground="#606060" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20"/>
                            </Border>
                        </Grid>

                        <Border Grid.Row="2"
                                Background="{StaticResource SurfaceLightBrush}"
                                BorderBrush="{StaticResource SecondaryBrush}"
                                BorderThickness="1"
                                Margin="5,10"
                                CornerRadius="6"
                                Height="60"
                                Visibility="{Binding ComboResult, Converter={StaticResource NullToVisibilityConverter}}">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding ComboResult.Name}"
                                           Foreground="{StaticResource AccentBrush}"
                                           FontSize="12" FontWeight="Bold"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Preview"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="10"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <Button Grid.Row="3"
                                Content="Combine!"
                                Style="{StaticResource AccentButtonStyle}"
                                Command="{Binding CombineCardsCommand}"
                                IsEnabled="{Binding CanCombine}"
                                Height="50"
                                FontSize="16"
                                Margin="5,10"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Card Zoom Overlay -->
        <Grid Grid.Row="0" Grid.RowSpan="5"
              Visibility="{Binding IsCardZoomed, Converter={StaticResource BoolToVisibilityConverter}}">
            <controls:CardZoomOverlay DataContext="{Binding ZoomedCard}"/>
        </Grid>
    </Grid>
</UserControl>
