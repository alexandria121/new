<UserControl x:Class="NewGame.UI.Views.DeckBuilderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:Converters="clr-namespace:NewGame.UI.Converters"
             xmlns:vm="clr-namespace:NewGame.UI.ViewModels"
             mc:Ignorable="d"
             Background="{StaticResource BackgroundBrush}">

    <UserControl.Resources>
        <Converters:TypeToColorConverter x:Key="TypeToColorConverter"/>
        <Converters:ElementToColorConverter x:Key="ElementToColorConverter"/>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
            <TextBlock Text="Deck Builder" Style="{StaticResource TitleStyle}"/>
            <Button Content="Clear Deck" 
                    Style="{StaticResource BaseButtonStyle}"
                    Command="{Binding ClearDeckCommand}"
                    Margin="30,0,0,0"
                    Padding="15,6"/>
            <Button Content="Start Game" 
                    Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding InitializeGameCommand}"
                    Margin="10,0,0,0"
                    Padding="15,6"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Available Cards -->
            <Border Grid.Column="0" 
                    Background="{StaticResource SurfaceBrush}"
                    CornerRadius="8"
                    Padding="15"
                    Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Available Cards"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="14"
                               FontWeight="Bold"
                               Margin="0,0,0,10"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding AvailableCards}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource SurfaceLightBrush}"
                                            BorderBrush="{Binding Type, Converter={StaticResource TypeToColorConverter}}"
                                            BorderThickness="2"
                                            CornerRadius="6"
                                            Padding="6"
                                            Margin="4"
                                            Width="130"
                                            Height="170"
                                            Cursor="Hand"
                                            MouseLeftButtonDown="Card_MouseLeftButtonDown"
                                            MouseMove="Card_MouseMove">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="35"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <Grid Grid.Row="0">
                                                <TextBlock Text="{Binding Name}"
                                                           Foreground="White"
                                                           FontSize="10"
                                                           FontWeight="Bold"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <Border HorizontalAlignment="Right"
                                                        Background="{StaticResource ManaBrush}"
                                                        CornerRadius="6"
                                                        Padding="4,1">
                                                    <TextBlock Text="{Binding ManaCost}"
                                                               Foreground="White"
                                                               FontSize="9"/>
                                                </Border>
                                            </Grid>

                                            <Border Grid.Row="1"
                                                    Background="{Binding Element, Converter={StaticResource ElementToColorConverter}}"
                                                    Margin="0,4"
                                                    CornerRadius="3">
                                                <TextBlock Text="{Binding Type}"
                                                           Foreground="#80FFFFFF"
                                                           FontSize="9"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>

                                            <Grid Grid.Row="2" Margin="0,2,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                    <TextBlock Text="P:" Foreground="{StaticResource DangerBrush}" FontSize="9"/>
                                                    <TextBlock Text="{Binding Power}" Foreground="{StaticResource DangerBrush}" FontSize="9" FontWeight="Bold"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <TextBlock Text="H:" Foreground="{StaticResource HealthBrush}" FontSize="9"/>
                                                    <TextBlock Text="{Binding Health}" Foreground="{StaticResource HealthBrush}" FontSize="9" FontWeight="Bold"/>
                                                </StackPanel>

                                                <Border Grid.Column="2"
                                                        Background="{StaticResource SurfaceBrush}"
                                                        CornerRadius="2"
                                                        Padding="2,1"
                                                        HorizontalAlignment="Right"
                                                        Visibility="{Binding HasEffects, Converter={StaticResource NullToVisibilityConverter}}">
                                                    <TextBlock Text="{Binding EffectsText}"
                                                               Foreground="{StaticResource AccentBrush}"
                                                               FontSize="7"
                                                               TextTrimming="CharacterEllipsis"
                                                               MaxWidth="40"/>
                                                </Border>
                                            </Grid>

                                            <TextBlock Grid.Row="3"
                                                       Text="{Binding Element}"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="8"
                                                       Margin="0,2,0,0"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Deck Preview -->
            <Border Grid.Column="1"
                    Background="{StaticResource SurfaceBrush}"
                    CornerRadius="8"
                    Padding="15"
                    AllowDrop="True"
                    Drop="Deck_Drop"
                    DragOver="Deck_DragOver">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Your Deck"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="14"
                               FontWeight="Bold"/>

                    <TextBlock Grid.Row="1"
                               Text="{Binding DeckCountText}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="12"
                               Margin="0,5,0,10"/>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding PlayerDeckCards}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource SurfaceLightBrush}"
                                            BorderBrush="{Binding Type, Converter={StaticResource TypeToColorConverter}}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="6"
                                            Margin="0,0,0,4"
                                            Width="Auto"
                                            MouseRightButtonDown="DeckCard_RightClick">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Name}"
                                                           Foreground="White"
                                                           FontSize="10"
                                                           FontWeight="Bold"/>
                                                <TextBlock Text="{Binding Element}"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           FontSize="8"/>
                                            </StackPanel>

                                            <Border Grid.Column="1"
                                                    Background="{StaticResource ManaBrush}"
                                                    CornerRadius="4"
                                                    Padding="4,2"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ManaCost}"
                                                           Foreground="White"
                                                           FontSize="9"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <TextBlock Grid.Row="3"
                               Text="Drag cards here to add to deck"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="12"
                               FontStyle="Italic"
                               Visibility="{Binding PlayerDeckCards.Count, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Inverse}"
                               Margin="0,10,0,0"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
