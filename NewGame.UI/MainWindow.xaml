<Window x:Class="NewGame.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NewGame.UI"
        xmlns:views="clr-namespace:NewGame.UI.Views"
        xmlns:vm="clr-namespace:NewGame.UI.ViewModels"
        xmlns:Converters="clr-namespace:NewGame.UI.Converters"
        mc:Ignorable="d"
        Title="Magical Deckbuilder"
        Height="800" Width="1200"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Navigation Bar -->
        <Border Grid.Row="0" 
                Background="{StaticResource SurfaceBrush}" 
                Padding="15,8"
                Visibility="{Binding CurrentView, Converter={StaticResource NotMenuToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Content="Menu" 
                            Style="{StaticResource BaseButtonStyle}"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="Menu"
                            Padding="15,6"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Magical Deckbuilder"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Margin="0,0,15,0"/>
                    <Button Content="X"
                            Style="{StaticResource BaseButtonStyle}"
                            Command="{Binding CloseCommand}"
                            Padding="10,6"
                            ToolTip="Close Application"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <ContentControl Grid.Row="1">
            <ContentControl.Style>
                <Style TargetType="ContentControl">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding CurrentView}" Value="Menu">
                            <Setter Property="Content">
                                <Setter.Value>
                                    <views:MenuView/>
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding CurrentView}" Value="Game">
                            <Setter Property="Content">
                                <Setter.Value>
                                    <views:GameView/>
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding CurrentView}" Value="Browser">
                            <Setter Property="Content">
                                <Setter.Value>
                                    <views:BrowserView/>
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding CurrentView}" Value="DeckBuilder">
                            <Setter Property="Content">
                                <Setter.Value>
                                    <views:DeckBuilderView/>
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding CurrentView}" Value="Gallery">
                            <Setter Property="Content">
                                <Setter.Value>
                                    <views:GalleryView/>
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding CurrentView}" Value="BattleSelect">
                            <Setter Property="Content">
                                <Setter.Value>
                                    <views:BattleSelectView/>
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding CurrentView}" Value="DeckSelection">
                            <Setter Property="Content">
                                <Setter.Value>
                                    <views:DeckSelectionView/>
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding CurrentView}" Value="Settings">
                            <Setter Property="Content">
                                <Setter.Value>
                                    <views:SettingsView/>
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ContentControl.Style>
        </ContentControl>
    </Grid>

</Window>
